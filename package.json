{
  "name": "lawyer-managment",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@lawyer/server\" \"npm run dev --workspace=@lawyer/client\"",
    "build": "npm run build --workspaces",
    "install:all": "npm install",
    "test": "npm run test --workspace=@lawyer/server",
    "test:coverage": "npm run test:coverage --workspace=@lawyer/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
